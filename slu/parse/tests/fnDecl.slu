
ex unsafe fn decl_helloWorld1() -> {u8,u8,u8}
ex safe fn decl_helloWorld2() -> *mut u8;
ex fn decl_helloWorld3() -> *[]u8;
unsafe fn decl_helloWorld4() -> *mut[]str;
safe fn decl_helloWorld5() -> *mut[]str
fn decl_helloWorld0() -> *const[]str

const decl_self = ex unsafe fn(self) -> **u8
const decl_rself = ex unsafe fn(*self) -> u8
const decl_rmself = ex unsafe fn(*mut self)
const decl_rrself = ex unsafe fn(**self)
const decl_rrmself = ex unsafe fn(**mut self)
const decl_rmrself = ex unsafe fn(*mut *self) -> *mut u8
const decl_rmrmself = ex unsafe fn(*mut *mut self)
